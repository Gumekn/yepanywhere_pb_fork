{
  "name": "@yep-anywhere/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/run-with-safe-home.js vite",
    "build": "node ../../scripts/check-typography.mjs && tsc && vite build",
    "build:stable": "node ../../scripts/check-typography.mjs && tsc && vite build --base /_stable/ --outDir dist-stable",
    "test": "node ../../scripts/run-with-safe-home.js vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "@yep-anywhere/shared": "workspace:*",
    "docx-preview": "^0.4.0",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.4.1",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.11.0",
    "uqr": "^0.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.1.0",
    "@types/hast": "^3.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
